ENTSOE_API_TOKEN=replace_with_your_entsoe_token

# Wattnet currently uses OAuth. Prefer a bearer token when available; otherwise
# use a temporary browser-session cookie locally. Never commit either value.
WATTNET_API_TOKEN=
WATTNET_COOKIE=

# Local MySQL connection used by the transform, EDA, ML, and SQL notebooks.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_mysql_password
MYSQL_DATABASE=smart_power
