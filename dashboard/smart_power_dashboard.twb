      <column caption='Recommended Window' datatype='string' name='[Calculation_3712051608006656]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [hour_local] &gt;= 12 AND [hour_local] &lt;= 15 THEN&#10;    &quot;Recommended: 12:00–16:00&quot;&#10;ELSE&#10;    &quot;Other hours&quot;&#10;END' />
